# Produkcja / staging. Skopiuj do deploy/.env.prod (plik w .gitignore) i uzupełnij.
# Sekrety generuj: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Klucz szyfrowania: python -m scripts.rotate_encryption_key generate
# Wszystkie sekrety trzymaj w menedżerze haseł; klucz szyfrowania OSOBNO od kopii bazy.

# --- Domena i TLS (Caddy) ---
DOMAIN=api.twojadomena.pl
ACME_EMAIL=admin@twojadomena.pl
HTTP_PORT=80
HTTPS_PORT=443

# --- Baza (kontener db; nie jest wystawiona na zewnątrz) ---
POSTGRES_USER=wedding
POSTGRES_PASSWORD=
POSTGRES_DB=wedding

# --- Aplikacja ---
# Procesy API = liczba vCPU (test obciążeniowy: 4 procesy → p95 list < 130 ms przy 100 parach).
# Połączenia z bazą: WEB_CONCURRENCY × (POOL_SIZE + MAX_OVERFLOW) + worker < 100.
WEB_CONCURRENCY=4
WP_JWT_SECRET=
WP_DATA_ENCRYPTION_KEY=
WP_DATA_ENCRYPTION_KEY_VERSION=1
WP_DATA_ENCRYPTION_PREVIOUS_KEYS=
WP_EXPOSE_DOCS=false
WP_PUBLIC_APP_URL=https://twojadomena.pl
WP_LOG_JSON=true
WP_LOG_LEVEL=INFO
WP_RATE_LIMIT_PER_MINUTE=600
WP_DB_POOL_SIZE=10
WP_DB_MAX_OVERFLOW=5

# --- E-mail (dostawca SMTP z umową powierzenia, serwery w UE) ---
WP_SMTP_HOST=
WP_SMTP_PORT=587
WP_SMTP_STARTTLS=true
WP_SMTP_USER=
WP_SMTP_PASSWORD=
WP_MAIL_FROM=Wedding Planner <no-reply@twojadomena.pl>

# --- Pliki: S3-compatible w UE (zalecane) albo lokalny wolumen ---
WP_STORAGE_BACKEND=s3
WP_S3_BUCKET=
WP_S3_ENDPOINT_URL=
WP_S3_REGION=
WP_S3_ACCESS_KEY_ID=
WP_S3_SECRET_ACCESS_KEY=

# --- AI: decyzja przy wyborze hostingu (docs/hosting.md). Na start można wyłączyć. ---
WP_AI_ENABLED=false
WP_AI_PROVIDER=ollama
WP_OLLAMA_URL=http://ollama:11434
WP_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Dokumenty prawne (wersje akceptowane przy rejestracji) ---
WP_TERMS_VERSION=
WP_PRIVACY_VERSION=
