{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "podglad-gui",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/podglad"
      ],
      "port": 8090
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "frontend-e2e",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set WP_API_URL=http://127.0.0.1:8011&& set WP_WEB_PORT=5174&& npm --prefix frontend run dev"
      ],
      "port": 5174
    }
  ]
}
