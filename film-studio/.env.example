# Never commit or share real credentials. The start script does not load .env automatically.
# Windows PowerShell for current session:
# $env:SOGNI_API_KEY = 'YOUR_NEW_KEY'
# python server.py
# Linux/macOS:
# export SOGNI_API_KEY='YOUR_NEW_KEY'
# python3 server.py
# For remote LAN access, also set STUDIO_ACCESS_TOKEN to a strong random password.
