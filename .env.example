# Skopiuj do .env (task setup robi to automatycznie). Nigdy nie commituj pliku .env.

# --- Docker Compose ---
POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding
POSTGRES_DB=wedding
POSTGRES_PORT=5433
API_PORT=8010

# --- Aplikacja (prefiks WP_) ---
WP_ENV=dev
# Lokalnie (testy, alembic z hosta). W kontenerach compose nadpisuje host na "db".
WP_DATABASE_URL=postgresql+psycopg://wedding:wedding@localhost:5433/wedding
WP_TEST_DATABASE_URL=postgresql+psycopg://wedding:wedding@localhost:5433/wedding_test
# Min. 32 znaki. task setup generuje losowy sekret. Wartość z "change-me" jest odrzucana w prod.
WP_JWT_SECRET=change-me-change-me-change-me-change-me
# Klucz AES-256 (base64, 32 bajty) do szyfrowania danych wrażliwych (np. uwag dietetycznych).
# task setup generuje losowy. UTRATA KLUCZA = utrata zaszyfrowanych danych: przechowuj go
# w menedżerze sekretów i w kopii zapasowej oddzielnie od bazy.
WP_DATA_ENCRYPTION_KEY=change-me
# Rotacja klucza (docs/wdrozenie.md): numer bieżącego klucza i stare klucze tylko do odczytu.
WP_DATA_ENCRYPTION_KEY_VERSION=1
WP_DATA_ENCRYPTION_PREVIOUS_KEYS=
WP_ACCESS_TOKEN_TTL_MINUTES=15
WP_REFRESH_TOKEN_TTL_DAYS=30
WP_REFRESH_REUSE_GRACE_SECONDS=30
# Globalny limit żądań na użytkownika/IP na proces API (0 = wyłączony)
WP_RATE_LIMIT_PER_MINUTE=600
WP_DB_POOL_SIZE=10
WP_DB_MAX_OVERFLOW=10
WP_SMTP_HOST=localhost
WP_SMTP_PORT=1025
WP_MAIL_FROM=Wedding Planner <no-reply@weddingplanner.local>
WP_PUBLIC_APP_URL=http://localhost:5173
WP_EXPOSE_DOCS=true
WP_LOG_LEVEL=INFO
WP_LOG_JSON=true

# --- Dokumenty i OCR ---
# Lokalnie (testy z hosta): katalog w projekcie (w .gitignore). W Dockerze: /app/storage (wolumen).
WP_STORAGE_BACKEND=local
WP_STORAGE_DIR=storage
# Dla WP_STORAGE_BACKEND=s3 (magazyn S3-compatible w UE):
WP_S3_BUCKET=
WP_S3_ENDPOINT_URL=
WP_S3_REGION=eu-central-1
WP_S3_ACCESS_KEY_ID=
WP_S3_SECRET_ACCESS_KEY=
WP_MAX_UPLOAD_MB=20
WP_MAX_DOCUMENTS_PER_WEDDING=300
WP_MAX_STORAGE_MB_PER_WEDDING=1000
WP_OCR_ENABLED=true
WP_OCR_LANGUAGES=pol+eng
WP_OCR_MAX_PAGES=20

# --- AI (ADR-0005): lokalny model przez Ollama, dane nie opuszczają komputera ---
WP_AI_ENABLED=true
WP_AI_PROVIDER=ollama
WP_OLLAMA_URL=http://localhost:11434
WP_OLLAMA_MODEL=qwen2.5:7b-instruct
WP_AI_TIMEOUT_SECONDS=600
WP_AI_MAX_RUNS_PER_WEDDING_PER_DAY=20

# --- Kopie zapasowe (task backup) ---
BACKUP_DIR=backups
# Opcjonalnie udział SMB na Synology, np. \\DS225\backup\wedding (zostaw puste, by pominąć)
BACKUP_TARGET=
BACKUP_KEEP=14
